@page "/restaurants"
@inject LunchNearApiClient Api
@inject GeolocationService Geo

<PageTitle>Restaurants — LunchNear</PageTitle>

<header class="page-header">
    <h1>Restaurants nearby</h1>
    <p>Student discounts, lunch deals and dish ratings</p>
</header>

<div class="discovery-toolbar">
    <div class="search-field">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path></svg>
        <input type="search"
               @bind="searchQuery"
               @bind:event="oninput"
               placeholder="Search by restaurant name"
               aria-label="Search restaurants by name" />
    </div>
    <div class="filter-chips">
        <button type="button" class="chip @(nearbyOnly ? "active" : "")" aria-pressed="@nearbyOnly" @onclick="ToggleNearby">
            Nearby
        </button>
        <button type="button" class="chip @(studentDiscountOnly ? "active" : "")" aria-pressed="@studentDiscountOnly" @onclick="ToggleStudentDiscount">
            Discounts
        </button>
        <button type="button" class="chip @(lunchOnly ? "active" : "")" aria-pressed="@lunchOnly" @onclick="ToggleLunch">
            Lunch
        </button>
    </div>
</div>

@if (loading)
{
    <div class="restaurant-list" aria-busy="true" aria-label="Loading restaurants">
        @for (var i = 0; i < 3; i++)
        {
            <article class="restaurant-card skeleton-card">
                <div class="restaurant-visual skeleton"></div>
                <div class="restaurant-card-body">
                    <div class="skeleton skeleton-title"></div>
                    <div class="skeleton skeleton-line"></div>
                    <div class="skeleton skeleton-rating"></div>
                </div>
            </article>
        }
    </div>
}
else if (error != null)
{
    <div class="state-panel">
        <span class="state-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M1 1 23 23"></path><path d="M8.5 5.5A15 15 0 0 1 12 5c5 0 9 2 11 5"></path><path d="M2 10c.7-.7 1.5-1.3 2.3-1.9"></path><path d="M5 15c1.8-1.3 4.2-2 7-2 .8 0 1.6.1 2.3.2"></path><path d="M8.5 19c1-.7 2.2-1 3.5-1"></path></svg></span>
        <h2>Couldn't load restaurants</h2>
        <p>@error</p>
        <button type="button" class="primary-button" @onclick="LoadRestaurantsAsync">Try again</button>
    </div>
}
else if (locationUnavailable && nearbyOnly)
{
    <div class="state-panel">
        <span class="state-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2 2 22 22"></path><path d="M12 22s8-7 8-12a8 8 0 0 0-12.7-6.5"></path><path d="M6.2 6.2A8 8 0 0 0 4 10c0 5 8 12 8 12"></path></svg></span>
        <h2>Location is off</h2>
        <p>Allow location access to sort restaurants by how close they are to you.</p>
        <button type="button" class="primary-button" @onclick="EnableLocationAsync">Use my location</button>
    </div>
}
else if (!displayRestaurants.Any())
{
    <div class="state-panel">
        <span class="state-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path><path d="m8 8 6 6"></path><path d="m14 8-6 6"></path></svg></span>
        <h2>No restaurants match</h2>
        <p>Try a different name, or turn off a filter to widen the search.</p>
        <button type="button" class="secondary-button" @onclick="ClearSearchAndFilters">Clear search and filters</button>
    </div>
}
else
{
    <p class="result-count" aria-live="polite">@displayRestaurants.Count() restaurant@(displayRestaurants.Count() == 1 ? "" : "s")</p>
    <div class="restaurant-list">
        @foreach (var item in displayRestaurants)
        {
            var restaurant = item.Restaurant!;
            var distance = item.DistanceKm;
            <a href="/restaurant/@restaurant.Id" class="restaurant-card">
                <div class="restaurant-card-body">
                    <div class="restaurant-title-row">
                        <h2>@restaurant.Name</h2>
                        <span class="price-badge" title="@($"{restaurant.PriceRange} price range")">@PriceSymbol(restaurant.PriceRange)</span>
                    </div>
                    <div class="restaurant-location-row">
                        <p class="restaurant-address">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 10c0 5-8 12-8 12S4 15 4 10a8 8 0 1 1 16 0Z"></path><circle cx="12" cy="10" r="2.5"></circle></svg>
                            @restaurant.Address
                        </p>
                        @if (distance > 0)
                        {
                            <span class="distance-inline">
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m3 11 19-9-9 19-2-8Z"></path></svg>
                                @distance.ToString("0.0") km
                            </span>
                        }
                    </div>
                    <RatingDisplay Value="@restaurant.AverageRating" Count="@restaurant.RatingsCount" />
                    @if (restaurant.HasStudentDiscount || restaurant.HasLunchDeals)
                    {
                    <div class="badges">
                    @if (restaurant.HasStudentDiscount && restaurant.StudentDiscountPercentage is int discountPercent)
                    {
                        <span class="feature-badge discount-badge glow">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m2 7 10-5 10 5-10 5Z"></path><path d="M6 9.5V16c3 2 9 2 12 0V9.5"></path></svg>
                            @discountPercent% student discount
                        </span>
                    }
                    @if (restaurant.HasLunchDeals)
                    {
                        <span class="feature-badge lunch-badge">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 11h16"></path><path d="M6 11a6 6 0 0 1 12 0"></path><path d="M3 15h18"></path><path d="M8 4h8"></path></svg>
                            Lunch deal
                        </span>
                    }
                    </div>
                    }
                </div>
            </a>
        }
    </div>
}

@code {
    private bool loading = true;
    private string? error;
    private string searchQuery = "";
    private bool nearbyOnly;
    private bool studentDiscountOnly;
    private bool lunchOnly;
    private bool locationUnavailable;
    private List<RestaurantListItem> allRestaurants = [];
    private double? userLat;
    private double? userLng;

    private IEnumerable<RestaurantListItem> displayRestaurants
    {
        get
        {
            var query = allRestaurants.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(searchQuery))
            {
                query = query.Where(r =>
                    (r.Restaurant?.Name ?? r.Name).Contains(searchQuery, StringComparison.OrdinalIgnoreCase));
            }

            if (studentDiscountOnly)
            {
                query = query.Where(r => r.HasStudentDiscount);
            }

            if (lunchOnly)
            {
                query = query.Where(r => r.HasLunchBuffet);
            }

            if (nearbyOnly && userLat.HasValue && userLng.HasValue)
            {
                query = query.Where(r => r.DistanceKm > 0).OrderBy(r => r.DistanceKm);
            }

            return query;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadRestaurantsAsync();
    }

    private async Task LoadRestaurantsAsync()
    {
        loading = true;
        error = null;
        try
        {
            var restaurants = await Api.GetRestaurantsAsync();
            allRestaurants = restaurants
                .Select(r => new RestaurantListItem { Restaurant = r })
                .ToList();
        }
        catch (Exception ex)
        {
            error = $"Failed to load restaurants: {ex.Message}";
        }
        finally
        {
            loading = false;
            StateHasChanged();
        }

        _ = TryApplyLocationAsync();
    }

    private async Task TryApplyLocationAsync()
    {
        try
        {
            var pos = await Geo.GetCurrentPositionAsync();
            if (!pos.HasValue)
            {
                locationUnavailable = true;
                return;
            }

            locationUnavailable = false;
            userLat = pos.Value.Lat;
            userLng = pos.Value.Lng;

            var nearby = await Api.GetNearbyRestaurantsAsync(userLat.Value, userLng.Value, 10);
            if (nearby.Count > 0)
            {
                allRestaurants = nearby
                    .Select(n => new RestaurantListItem
                    {
                        Restaurant = n.Restaurant,
                        DistanceKm = n.DistanceKm
                    })
                    .ToList();
            }
        }
        catch
        {
            locationUnavailable = true;
        }

        StateHasChanged();
    }

    private async Task ToggleNearby()
    {
        nearbyOnly = !nearbyOnly;
        if (nearbyOnly && !userLat.HasValue)
        {
            await EnableLocationAsync();
        }
    }

    private async Task EnableLocationAsync()
    {
        var pos = await Geo.GetCurrentPositionAsync();
        if (!pos.HasValue)
        {
            locationUnavailable = true;
            StateHasChanged();
            return;
        }

        locationUnavailable = false;
        userLat = pos.Value.Lat;
        userLng = pos.Value.Lng;

        try
        {
            var nearby = await Api.GetNearbyRestaurantsAsync(userLat.Value, userLng.Value, 10);
            allRestaurants = nearby.Count > 0
                ? nearby.Select(n => new RestaurantListItem
                {
                    Restaurant = n.Restaurant,
                    DistanceKm = n.DistanceKm
                }).ToList()
                : allRestaurants;
        }
        catch
        {
            locationUnavailable = true;
        }

        StateHasChanged();
    }

    private void ClearSearchAndFilters()
    {
        searchQuery = "";
        nearbyOnly = false;
        studentDiscountOnly = false;
        lunchOnly = false;
    }

    private void ToggleStudentDiscount() => studentDiscountOnly = !studentDiscountOnly;
    private void ToggleLunch() => lunchOnly = !lunchOnly;

    private static string PriceSymbol(string priceRange) => priceRange switch
    {
        "Cheap" => "kr",
        "Medium" => "kr kr",
        "Expensive" => "kr kr kr",
        _ => priceRange
    };

    private class RestaurantListItem
    {
        public RestaurantDto? Restaurant { get; set; }
        public double DistanceKm { get; set; }

        public string Name => Restaurant?.Name ?? "";
        public bool HasStudentDiscount => Restaurant?.HasStudentDiscount ?? false;
        public bool HasLunchBuffet => Restaurant?.HasLunchDeals ?? false;
    }
}
