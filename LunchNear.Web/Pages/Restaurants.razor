@page "/restaurants"
@inject LunchNearApiClient Api
@inject GeolocationService Geo

<PageTitle>Restaurants — LunchNear</PageTitle>

<div class="app-header">
    <h1>Restaurants nearby</h1>
    <p class="subtitle">Student discounts, lunch deals and dish ratings</p>
</div>

<div class="filters">
    <input type="search" @bind="searchQuery" @bind:event="oninput" placeholder="Search..." class="form-control" />
    <div class="filter-chips">
        <button class="chip @(nearbyOnly ? "active" : "")" @onclick="ToggleNearby">
            📍 Nearby
        </button>
        <button class="chip @(studentDiscountOnly ? "active" : "")" @onclick="ToggleStudentDiscount">
            🎓 Discounts
        </button>
        <button class="chip @(lunchOnly ? "active" : "")" @onclick="ToggleLunch">
            🍽️ Lunch
        </button>
    </div>
</div>

@if (loading)
{
    <div class="loading-state">Loading...</div>
}
else if (error != null)
{
    <div class="alert alert-danger">@error</div>
}
else if (!displayRestaurants.Any())
{
    <div class="empty-state">No restaurants found</div>
}
else
{
    <div class="restaurant-list">
        @foreach (var item in displayRestaurants)
        {
            var restaurant = item.Restaurant!;
            var distance = item.DistanceKm;
            <a href="/restaurant/@restaurant.Id" class="restaurant-card">
                <div class="card-header-row">
                    <h2>@restaurant.Name</h2>
                    <span class="rating-badge">⭐ @restaurant.AverageRating.ToString("0.0")</span>
                </div>
                <p class="address">@restaurant.Address</p>
                @if (distance > 0)
                {
                    <p class="distance">@distance.ToString("0.0") km</p>
                }
                <div class="badges">
                    <span class="badge price">@restaurant.PriceRange</span>
                    @if (restaurant.HasStudentDiscount)
                    {
                        <span class="badge student">🎓 Discount</span>
                    }
                    @if (restaurant.HasLunchDeals)
                    {
                        <span class="badge lunch">🍽️ Lunch</span>
                    }
                </div>
            </a>
        }
    </div>
}

@code {
    private bool loading = true;
    private string? error;
    private string searchQuery = "";
    private bool nearbyOnly;
    private bool studentDiscountOnly;
    private bool lunchOnly;
    private List<RestaurantListItem> allRestaurants = [];
    private double? userLat;
    private double? userLng;

    private IEnumerable<RestaurantListItem> displayRestaurants
    {
        get
        {
            var query = allRestaurants.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(searchQuery))
            {
                query = query.Where(r =>
                    (r.Restaurant?.Name ?? r.Name).Contains(searchQuery, StringComparison.OrdinalIgnoreCase));
            }

            if (studentDiscountOnly)
            {
                query = query.Where(r => r.HasStudentDiscount);
            }

            if (lunchOnly)
            {
                query = query.Where(r => r.HasLunchBuffet);
            }

            if (nearbyOnly && userLat.HasValue && userLng.HasValue)
            {
                query = query.Where(r => r.DistanceKm > 0).OrderBy(r => r.DistanceKm);
            }

            return query;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var pos = await Geo.GetCurrentPositionAsync();
            if (pos.HasValue)
            {
                userLat = pos.Value.Lat;
                userLng = pos.Value.Lng;
                var nearby = await Api.GetNearbyRestaurantsAsync(userLat.Value, userLng.Value, 10);
                allRestaurants = nearby.Select(n => new RestaurantListItem
                {
                    Restaurant = n.Restaurant,
                    DistanceKm = n.DistanceKm
                }).ToList();
            }
            else
            {
                var restaurants = await Api.GetRestaurantsAsync();
                allRestaurants = restaurants.Select(r => new RestaurantListItem { Restaurant = r }).ToList();
            }
        }
        catch (Exception ex)
        {
            error = $"Failed to load restaurants: {ex.Message}";
        }
        finally
        {
            loading = false;
        }
    }

    private async Task ToggleNearby()
    {
        nearbyOnly = !nearbyOnly;
        if (nearbyOnly && !userLat.HasValue)
        {
            var pos = await Geo.GetCurrentPositionAsync();
            if (pos.HasValue)
            {
                userLat = pos.Value.Lat;
                userLng = pos.Value.Lng;
                var nearby = await Api.GetNearbyRestaurantsAsync(userLat.Value, userLng.Value, 10);
                allRestaurants = nearby.Select(n => new RestaurantListItem
                {
                    Restaurant = n.Restaurant,
                    DistanceKm = n.DistanceKm
                }).ToList();
            }
            else
            {
                error = "Please allow location access to search nearby";
                nearbyOnly = false;
            }
        }
    }
    private void ToggleStudentDiscount() => studentDiscountOnly = !studentDiscountOnly;
    private void ToggleLunch() => lunchOnly = !lunchOnly;

    private class RestaurantListItem
    {
        public RestaurantDto? Restaurant { get; set; }
        public double DistanceKm { get; set; }

        public string Name => Restaurant?.Name ?? "";
        public bool HasStudentDiscount => Restaurant?.HasStudentDiscount ?? false;
        public bool HasLunchBuffet => Restaurant?.HasLunchDeals ?? false;
    }
}
