<div class="star-picker @Size" role="radiogroup" aria-label="@Label">
    @for (var i = 1; i <= MaxStars; i++)
    {
        var star = i;
        <button type="button"
                class="star-btn @(star <= Value ? "filled" : "")"
                role="radio"
                aria-checked="@(Value == star)"
                aria-label="@($"{star} star{(star == 1 ? "" : "s")}")"
                disabled="@(ReadOnly || Disabled)"
                @onclick="() => Select(star)">
            ★
        </button>
    }
</div>

@code {
    [Parameter] public int Value { get; set; }
    [Parameter] public EventCallback<int> ValueChanged { get; set; }
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string Label { get; set; } = "Rating";
    [Parameter] public string Size { get; set; } = "medium";
    [Parameter] public int MaxStars { get; set; } = 5;

    private async Task Select(int star)
    {
        if (ReadOnly || Disabled) return;
        Value = star;
        await ValueChanged.InvokeAsync(star);
    }
}
